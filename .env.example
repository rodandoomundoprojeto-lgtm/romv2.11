# Configurações do Radar de Notícias & Briefing Editorial
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelos Opcionais do Gemini (padrões: gemini-2.5-flash para pulso/radar e gemini-2.5-pro para editorial)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PULSO=gemini-2.5-flash
GEMINI_MODEL_EDITORIAL=gemini-2.5-pro

# Agente de Manutenção & Sentinela do Site (Groq / xAI Grok)
# Chave Groq (gsk_...) em: https://console.groq.com/
# Chave xAI (xai-...) em: https://console.x.ai/
XAI_API_KEY=sua_chave_aqui
XAI_MODEL=grok-2-mini
GROQ_MODEL=openai/gpt-oss-20b

# Notificações do Discord Segmentadas por Canal (ou use DISCORD_WEBHOOK_URL como geral)
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_MANUTENCAO=
DISCORD_WEBHOOK_CRITICO=
DISCORD_WEBHOOK_RADAR=
DISCORD_WEBHOOK_EDITORIAL=
DISCORD_PING_ON_CRITICAL=false

# Notificações Opcionais: Telegram / Webhook Geral
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Senha alternativa de acesso rápido ao /admin pelo navegador/celular
ADMIN_PASSWORD=sua_senha_admin_aqui
ADMIN_USERS='{"admin1":"senha1","admin2":"senha2"}'
